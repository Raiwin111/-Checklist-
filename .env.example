# ─────────────────────────────────────────────────────────────
# Frontend environment variables (Vite)
# Copy this file to .env.local and fill in your own values.
# Only variables prefixed with VITE_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key. Safe for the browser when RLS is enabled.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ─────────────────────────────────────────────────────────────
# DO NOT put secrets here.
#
# The SerpAPI key must live in the Edge Function, never in the frontend:
#   supabase secrets set SERPAPI_API_KEY=your-key
#
# Never place a service_role / sb_secret_... key in any VITE_ variable.
# ─────────────────────────────────────────────────────────────
